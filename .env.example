# Переменные окружения контейнера (в Dokploy — вкладка Environment, тип Application)

# Порт, на котором слушает сервер. Задаётся Traefik как target port.
PORT=3000

# ОБЯЗАТЕЛЬНО для админки: без пароля раздел /admin отдаёт 503.
# При смене пароля все активные сессии админки сбрасываются.
ADMIN_PASSWORD=

# Каталог для данных админки и загруженных фото. Должен быть на томе,
# иначе edits пропадают при пересборке контейнера.
DATA_DIR=/app/storage

# Часов до повторного входа в админку.
ADMIN_SESSION_HOURS=12

# МиБ на одно загружаемое фото и на JSON-запрос проекта.
MAX_UPLOAD_MB=8
MAX_BODY_MB=2

# Сколько заявок хранить (старые удаляются сверх лимита).
MAX_LEADS=1000

# Необязательный срок хранения заявки в днях. Пустое значение отключает
# автоматическое удаление по возрасту; срок должен быть утверждён оператором.
LEAD_RETENTION_DAYS=
